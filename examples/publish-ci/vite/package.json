{
  "name": "rtk-esm-vite-normal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist/ test-results/ node_modules/.tmp/tsconfig.{app,node}.tsbuildinfo",
    "dev": "vite --config=vite.config.ts",
    "build": "tsc -b tsconfig.build.json && vite --config=vite.config.ts build",
    "preview": "vite --config=vite.config.ts preview",
    "serve-app": "serve -s dist",
    "check-bundle": "node ../scripts/check-bundled-modules.mjs dist",
    "test": "yarn check-bundle && playwright test --config=playwright.config.ts",
    "format": "prettier --write \"./src/**/*.{ts,tsx}\" \"**/*.md\""
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "msw": "^2.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "serve": "^14.2.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  },
  "msw": {
    "workerDirectory": "public"
  }
}
