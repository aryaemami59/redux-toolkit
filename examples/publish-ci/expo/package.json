{
  "name": "expo-template-redux-typescript",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "android": "expo run:android",
    "build": "expo export --platform android --output-dir build --source-maps",
    "check-bundle": "node ../scripts/check-bundled-modules.mjs build",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "ios": "expo run:ios",
    "lint:fix": "eslint --config=eslint.config.mjs --fix .",
    "lint": "eslint --config=eslint.config.mjs .",
    "start": "expo start",
    "test": "yarn check-bundle && jest",
    "type-check": "tsc --noEmit",
    "web": "expo start --web"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "expo": "~57.0.12",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-android": "^20.2.0",
    "@react-native-community/cli-platform-ios": "^20.2.0",
    "@react-native/jest-preset": "^0.86.2",
    "@react-native/metro-config": "^0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/babel__core": "^7.20.5",
    "@types/jest": "29.5.14",
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-x": "^5.18.3",
    "globals": "^17.9.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.2.3",
    "test-renderer": "^1.2.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "private": true
}
