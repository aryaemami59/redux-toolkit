{
  "name": "rtk-esm-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rimraf .next/ dist/ test-results/ node_modules/.tmp/tsconfig.tsbuildinfo next-env.d.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc",
    "serve-app": "yarn start",
    "check-bundle": "node ../scripts/check-bundled-modules.mjs .next/static",
    "test": "yarn check-bundle && playwright test --config=playwright.config.ts",
    "format": "prettier --write \"./src/**/*.{ts,tsx}\" \"**/*.md\""
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "msw": "^2.15.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "serve": "^14.2.6",
    "typescript": "^6.0.3"
  },
  "msw": {
    "workerDirectory": "public"
  }
}
